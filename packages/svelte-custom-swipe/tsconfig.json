{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "baseUrl": "./",
    "paths": {
      "swipe-core-provider": ["../core/src/index.ts"]
    }
  }
}

